import numpy as np
import matplotlib.pyplot as plt
from scipy import stats

control = [5, 6, 4, 7, 5, 6, 4, 5]

treatment = [12, 14, 13, 15, 11, 14, 13, 16]

t, p = stats.ttest_ind(treatment, control)

print("Control Mean:", np.mean(control))
print("Treatment Mean:", np.mean(treatment))
print("P-value:", p)

if p < 0.05:
    print("Treatment is Statistically Significant")
else:
    print("Treatment is Not Statistically Significant")

plt.bar(['Control', 'Treatment'],
        [np.mean(control), np.mean(treatment)])

plt.title("Treatment Comparison")
plt.ylabel("Mean Reduction")
plt.show()
